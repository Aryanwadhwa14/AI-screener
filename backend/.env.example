# Backend Environment Variables
ENVIRONMENT=production
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite Local Database (Default Standalone Zero-Config)
SQLITE_DB_PATH=data/app.db
LOCAL_STORAGE_DIR=data/storage/resumes

# AI Extraction Provider (Optional: Gemini, OpenAI, or Mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key

# Optional Supabase (If migrating away from SQLite)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_NAME=resumes

